data/*.json
data/*.csv
data/*.log
!data/community-ranking-state.json
!data/community_ranking.json
!data/youtube-channel.json
data/.community-ranking-cache/
data/.community-ranking-checkpoints/
community_ranking*.json
community_ranking*.csv
community_activity_log*.csv

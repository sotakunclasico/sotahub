generator client {
  provider = "prisma-client"
  output   = "../src/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MODERATOR
  USER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  TRANSFERRED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum GiveawayStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

model User {
  id               String              @id @default(cuid())
  discordId        String?             @unique
  email            String?             @unique
  name             String?
  image            String?
  role             Role                @default(USER)
  points           Decimal             @default(0) @db.Decimal(12, 2)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  orders           Order[]
  certificates     Certificate[]
  rankingEntries   RankingEntry[]
  achievements     UserAchievement[]
  giveawayEntries  GiveawayEntry[]
  auditLogs        AuditLog[]          @relation("AuditActor")
  externalAccounts ExternalAccount[]
  youtubeChannel   YouTubeChannelLink?

  @@index([points])
}

model ExternalAccount {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               String
  providerAccountId      String
  scopes                 String[]
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model YouTubeChannelLink {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId       String    @unique
  title           String
  handle          String?
  thumbnail       String?
  rankingUsername String?
  linkedAt        DateTime  @default(now())
  verifiedAt      DateTime?
  lastSyncedAt    DateTime?

  @@index([rankingUsername])
}

model Collection {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  products     Product[]
  certificates Certificate[]
  createdAt    DateTime      @default(now())
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  description  String
  priceInCents Int
  status       ProductStatus    @default(DRAFT)
  collectionId String?
  collection   Collection?      @relation(fields: [collectionId], references: [id])
  variants     ProductVariant[]
  orderItems   OrderItem[]
  certificates Certificate[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

model ProductVariant {
  id        String  @id @default(cuid())
  sku       String  @unique
  name      String
  stock     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id           String      @id @default(cuid())
  number       String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  status       OrderStatus @default(PENDING)
  totalInCents Int
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, status])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  quantity         Int
  unitPriceInCents Int
}

model Certificate {
  id           String            @id @default(uuid())
  number       String            @unique
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  collectionId String?
  collection   Collection?       @relation(fields: [collectionId], references: [id])
  designer     String
  ownerId      String?
  owner        User?             @relation(fields: [ownerId], references: [id])
  issuedAt     DateTime          @default(now())
  qrPayload    String            @unique
  status       CertificateStatus @default(ACTIVE)
  verified     Boolean           @default(false)

  @@index([ownerId, status])
}

model RankingSeason {
  id       String         @id @default(cuid())
  name     String
  startsAt DateTime
  endsAt   DateTime
  entries  RankingEntry[]

  @@unique([startsAt, endsAt])
}

model RankingEntry {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId String
  season   RankingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  points   Decimal       @default(0) @db.Decimal(12, 2)
  position Int?

  @@unique([userId, seasonId])
  @@index([seasonId, points])
}

model Achievement {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String
  icon        String
  users       UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  awardedAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model Giveaway {
  id          String          @id @default(cuid())
  title       String
  description String
  status      GiveawayStatus  @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime
  entries     GiveawayEntry[]
  createdAt   DateTime        @default(now())
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight     Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([giveawayId, userId])
}

model NewsArticle {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

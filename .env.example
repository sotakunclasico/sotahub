# URL pública de SotaHub
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Discord OAuth y comunidad
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=
ADMIN_DISCORD_IDS=
ADMIN_DISCORD_USERNAME=

# Vinculación individual con YouTube OAuth
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/link/callback

# Datos públicos del canal y ranking
YOUTUBE_API_KEY=
CRON_SECRET=
COMMUNITY_RANKING_AUTOSTART=false
COMMUNITY_RANKING_PYTHON=python
COMMUNITY_RANKING_SCRIPT_PATH=
COMMUNITY_RANKING_INCREMENTAL_MINUTES=10
COMMUNITY_RANKING_INCREMENTAL_VIDEO_LIMIT=10
COMMUNITY_RANKING_FULL_INTERVAL_DAYS=30
SOTAHUB_RUNTIME=local

# Motor remoto del ranking (producción Cloudflare + Render)
RANKING_ENGINE_URL=
RANKING_ENGINE_SECRET=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sotahub-ranking

# Persistencia futura
DATABASE_URL=

# Recepción de propuestas de colaboración
RESEND_API_KEY=
COLLABORATION_EMAIL_TO=
# Ejemplo: SotaKun <colaboraciones@tudominio.com>
COLLABORATION_EMAIL_FROM=

# Protección antispam del formulario
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
